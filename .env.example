# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env.
# In production, secrets are Docker secrets files in infra/secrets/ (git-ignored) — L2 §8.6.
NODE_ENV=development
API_PORT=3000
# Number of reverse proxies in front of the API: 0 locally, 1 behind Nginx (L2 §4.4).
TRUST_PROXY=0
# Local values: run `npm run dev:secrets`, which names the infra/secrets/ file whose content replaces each CHANGE_ME.
DATABASE_URL=postgresql://s360_app:CHANGE_ME@127.0.0.1:5432/secure360
MIGRATION_DATABASE_URL=postgresql://s360_owner:CHANGE_ME@127.0.0.1:5432/secure360
# Integration tests (npm run test:integration -w @secure360/api): bootstrap superuser, database secure360_test,
# which the suite drops and recreates on every run. Never point it at a real database.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/secure360_test
# npm run db:seed:dev (local only): password of every fictitious user. Must pass the password policy
# (10+ characters, upper case, lower case, digit); the placeholder below is refused on purpose.
DEV_SEED_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
# Host ports of the local services (defaults 5432 / 6379), e.g. when a local Redis already uses 6379.
# Docker Compose does not read this file: export them in the shell before npm run dev:up and dev:secrets
# (Git Bash: export REDIS_HOST_PORT=16379), and use the same ports in the URLs above.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# Key material: npm run dev:secrets writes it to infra/secrets/ and never prints it; copy each file's content here.
JWT_SECRET=CHANGE_ME_content_of_infra_secrets_jwt_secret
# Data-encryption keyring (L2 §8.6): <id>:<base64 of 32 bytes>, several entries separated by commas.
DATA_ENCRYPTION_KEYS=CHANGE_ME_content_of_infra_secrets_data_encryption_keys
# Not a secret: the id of the keyring entry that encrypts new data. Must exist in DATA_ENCRYPTION_KEYS.
DATA_ENCRYPTION_ACTIVE_KEY_ID=1
# Rate-limit e-mail keys (HMAC-SHA256): base64 of at least 32 bytes. Separate from the data-encryption keys.
RATE_LIMIT_HMAC_KEY=CHANGE_ME_content_of_infra_secrets_rate_limit_hmac_key
LOG_LEVEL=debug
