# Copy to .env for LOCAL DEVELOPMENT ONLY. Never commit .env.
# In production, secrets are Docker secrets files in infra/secrets/ (git-ignored) — L2 §8.6.
NODE_ENV=development
API_PORT=3000
# Number of reverse proxies in front of the API: 0 locally, 1 behind Nginx (L2 §4.4).
TRUST_PROXY=0
# Local values: run `npm run dev:secrets`, which prints these three lines with the generated passwords.
DATABASE_URL=postgresql://s360_app:CHANGE_ME@127.0.0.1:5432/secure360
MIGRATION_DATABASE_URL=postgresql://s360_owner:CHANGE_ME@127.0.0.1:5432/secure360
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379
# Host ports of the local services (defaults 5432 / 6379), e.g. when a local Redis already uses 6379.
# Docker Compose does not read this file: export them in the shell before npm run dev:up and dev:secrets
# (Git Bash: export REDIS_HOST_PORT=16379), and use the same ports in the URLs above.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
DATA_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
LOG_LEVEL=debug
