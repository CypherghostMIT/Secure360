{
  "name": "@secure360/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Secure360 shared contract: Zod schemas, inferred types, error and category codes, i18n keys, design tokens",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.4",
    "tsup": "8.5.1",
    "vitest": "5.0.4"
  }
}
