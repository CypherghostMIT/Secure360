{
  "name": "@secure360/api",
  "version": "0.1.0",
  "private": true,
  "description": "Secure360 REST API (Express 5, TypeScript)",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/main.api.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.api.ts",
    "prebuild": "npm run build -w @secure360/shared",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.api.js",
    "pretypecheck": "npm run build -w @secure360/shared",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "pretest": "npm run build -w @secure360/shared",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "echo \"none yet\""
  },
  "dependencies": {
    "@secure360/shared": "*",
    "express": "5.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
